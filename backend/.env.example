# Modelo das variaveis de ambiente.
# Copie este arquivo para .env (na mesma pasta) e preencha os valores.
# O .env de verdade NAO vai para o git.

# Conta do Gmail que envia o e-mail de redefinicao de senha
EMAIL_USER=

# Senha de app do Gmail (nao e a senha da conta).
# Gerada em: Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app
EMAIL_SENHA_APP=

# Texto secreto usado para assinar os tokens JWT.
# Use algo longo e aleatorio. Para gerar um:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
